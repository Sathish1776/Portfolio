.contact-form input,
.contact-form textarea{
    width:100%;
    padding:14px;
    border-radius:10px;
    border:1px solid #444;
    background:#1b1f38;
    color:white;
    font-size:16px;
    box-sizing:border-box;
}

.contact-form textarea{
    min-height:150px;
    resize:vertical;
}

.contact-form .field{
    margin-bottom:20px;
}

.contact-form .form-row{
    display:flex;
    gap:20px;
}

.contact-form .form-row .field{
    flex:1;
}

.contact-form button{
    width:100%;
    padding:15px;
    border:none;
    border-radius:12px;
    background:linear-gradient(90deg,#2563eb,#22d3ee);
    color:white;
    font-size:18px;
    cursor:pointer;
}
