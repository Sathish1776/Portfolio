.contact-form input,
.contact-form textarea{
    width:100%;
    padding:14px;
    border-radius:10px;
    border:1px solid #444;
    background:#1b1f38;
    color:white;
    font-size:16px;
    box-sizing:border-box;
}

.contact-form textarea{
    min-height:150px;
    resize:vertical;
}

.contact-form .field{
    margin-bottom:20px;
}

.contact-form .form-row{
    display:flex;
    gap:20px;
}

.contact-form .form-row .field{
    flex:1;
}

.contact-form button{
    width:100%;
    padding:15px;
    border:none;
    border-radius:12px;
    background:linear-gradient(90deg,#2563eb,#22d3ee);
    color:white;
    font-size:18px;
    cursor:pointer;
}

.project-media {
    position: relative;
    overflow: hidden;
}

.project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.project-media .tag {
    position: absolute;
    top: 15px;
    left: 15px;
    z-index: 2;
}
